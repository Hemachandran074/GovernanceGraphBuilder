# Copy this file to `.env` for local development and adjust as needed.
# In production these are supplied by the ECS task definition / AWS Secrets Manager.

# --- Application ---
APP_NAME=governance-graph-builder
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=true

# --- HTTP / CORS (comma-separated origins allowed by the browser frontend) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Neo4j ---
# Local docker-compose uses bolt://localhost:7687 from the host,
# or bolt://neo4j:7687 from inside the compose network.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=localdevpassword
NEO4J_DATABASE=neo4j
NEO4J_CONNECTION_TIMEOUT=5.0

# --- LLM (policy-document parsing) ---
# auto uses the first available real provider (Bedrock/OpenAI/Anthropic),
# otherwise falls back to the offline deterministic heuristic parser.
LLM_PROVIDER=auto
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.0

# AWS Bedrock (primary). Credentials come from the standard AWS chain
# (env vars, shared config, or the ECS task role in production).
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Optional direct providers (leave unset to skip)
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
